# --- dbt ---
# Anchored to the dbt project's own target/dbt_packages/logs dirs so we
# never accidentally ignore a *source* directory that happens to share
# one of these names elsewhere in the repo.
dbt/retail_margin_cockpit/target/
dbt/retail_margin_cockpit/dbt_packages/
dbt/retail_margin_cockpit/logs/
dbt/retail_margin_cockpit/.user.yml
target/
dbt_packages/
logs/

# --- DuckDB data files (regenerated by tests / dbt build) ---
*.duckdb
*.duckdb.wal

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# --- env / secrets ---
.env
.env.*
!.env.example
